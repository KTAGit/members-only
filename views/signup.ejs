<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Sign-up</title>
</head>
<body>
    <div class="signup-main-container">
        <h2>MEMBERS ONLY</h2>
        <form action="" method="post">
            <div class="form-title-wrapper">
                <h1>Create your account</h1>
                <p>Join the clubhouse to participate in confidential community posts</p>
            </div>

            <div class="first-last-name-container">
                <div class="first-name-wrapper">
                    <label for="first-name">FIRST NAME *</label>
                    <input type="text" name="firstName" id="first-name" placeholder="Julian" required>
                </div>
                <div class="last-name-wrapper">
                    <label for="last-name">LAST NAME *</label>
                    <input type="text" name="lastName" id="last-name" placeholder="Vane" required>
                </div>
            </div>
            <div class="username-wrapper">
                <label for="username">USER NAME *</label>
                <input type="text" name="username" id="username" placeholder="kingjulian" required>
            </div>

            <div class="main-password-container">
                <div class="password-wrapper">
                    <label for="password">PASSWORD</label>
                    <input type="password" name="password" id="password" placeholder="••••••••••••" required>
                </div>
                <div class="password-wrapper">
                    <label for="confirm-password">CONFIRM PASSWORD</label>
                    <input type="password" name="confirmPassword" id="confirm-password" placeholder="••••••••••••" required>
                </div>
            </div>

            <div class="line-divider"></div>
            
            <div class="admin-input-container">
                <p>ADMIN ACCESS</p>
                <div class="admin-input-wrapper">
                    <label for="admin">ADMIN SECRET KEY</label>
                    <input type="text" name="admin" id="admin" placeholder="Enter secret passcode">
                </div>
                <p> 
                    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M440-280h80v-240h-80v240Zm68.5-331.5Q520-623 520-640t-11.5-28.5Q497-680 480-680t-28.5 11.5Q440-657 440-640t11.5 28.5Q463-600 480-600t28.5-11.5ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    Leave blank if you're creating a regular account.</p>
            </div>

            <div class="button-wrapper">
                <button>
                    CREATE ACCOUNT
                </button>
            </div>


        </form>
    </div>
    
</body>
</html>